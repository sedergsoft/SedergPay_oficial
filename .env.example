SEDERG_DB_DSN=mysql:host=127.0.0.1;dbname=sederg_pay
SEDERG_DB_USER=sederg_app
SEDERG_DB_PASSWORD=change-this-app-password
SEDERG_MYSQL_ROOT_PASSWORD=change-this-root-password
SEDERG_AUTH_MODE=development
SEDERG_COOKIE_KEY=replace-with-a-random-32-byte-secret
SEDERG_PII_KEY=replace-with-a-random-encryption-secret
SEDERG_ACCOUNT_ENCRYPTION_KEY=
# Generate a local 32-byte key with scripts/Initialize-LocalAccountEncryption.ps1; never commit .env.
SEDERG_MAIL_TRANSPORT=smtp
SEDERG_MAIL_HOST=smtp-relay.brevo.com
SEDERG_MAIL_PORT=587
SEDERG_MAIL_ENCRYPTION=tls
SEDERG_MAIL_USERNAME=your-smtp-login
SEDERG_MAIL_PASSWORD=your-smtp-password
SEDERG_MAIL_FROM=no-reply@your-domain.example
SEDERG_APP_URL=http://localhost:5173
SEDERG_OIDC_ISSUER=https://identity.example.invalid/realms/sederg
SEDERG_OIDC_AUDIENCE=sederg-pay-api
SEDERG_OIDC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----replace-with-provider-key-----END PUBLIC KEY-----"
SEDERG_CORS_ORIGINS=http://localhost:5173,https://sedergsoft.github.io
VITE_AUTH_MODE=development
VITE_API_BASE_URL=
# In non-development frontend deployments, inject the access token through the OIDC host integration.
# VITE_OIDC_ACCESS_TOKEN is intentionally not supported as a build-time secret.
