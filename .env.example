SEDERG_DB_DSN=mysql:host=127.0.0.1;dbname=sederg_pay
SEDERG_DB_USER=sederg_app
SEDERG_DB_PASSWORD=change-this-app-password
SEDERG_MYSQL_ROOT_PASSWORD=change-this-root-password
SEDERG_AUTH_MODE=development
SEDERG_COOKIE_KEY=replace-with-a-random-32-byte-secret
SEDERG_PII_KEY=replace-with-a-random-encryption-secret
SEDERG_ACCOUNT_ENCRYPTION_KEY=
# Generate a local 32-byte key with scripts/Initialize-LocalAccountEncryption.ps1; never commit .env.
SEDERG_MAIL_TRANSPORT=smtp
SEDERG_MAIL_HOST=smtp-relay.brevo.com
SEDERG_MAIL_PORT=587
SEDERG_MAIL_ENCRYPTION=tls
SEDERG_MAIL_USERNAME=your-smtp-login
SEDERG_MAIL_PASSWORD=your-smtp-password
SEDERG_MAIL_FROM=no-reply@your-domain.example
SEDERG_APP_URL=http://localhost:5173
SEDERG_OIDC_ISSUER=https://identity.example.invalid/realms/sederg
SEDERG_OIDC_AUDIENCE=sederg-pay-api
SEDERG_OIDC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----replace-with-provider-key-----END PUBLIC KEY-----"
SEDERG_CORS_ORIGINS=http://localhost:5173,https://sedergsoft.github.io
# Ballerine KYC (optional until a reviewed self-hosted instance is available).
# Leave disabled to keep the existing Yii2 document-upload flow as the only active path.
# For local end-to-end tests, run scripts/Enable-BallerineMock.ps1 instead of editing these values by hand.
SEDERG_BALLERINE_ENABLED=0
SEDERG_BALLERINE_BASE_URL=
SEDERG_BALLERINE_API_KEY=
SEDERG_BALLERINE_WORKFLOW_ID=
SEDERG_BALLERINE_COLLECTION_URL=
# Default: {collectionBaseUrl}?workflowRuntimeId={workflowRuntimeId}
# Supported placeholders: {collectionBaseUrl}, {workflowRuntimeId}, {casePublicId}, {entityId}, {returnUrl}, {locale}
SEDERG_BALLERINE_COLLECTION_URL_TEMPLATE=
SEDERG_BALLERINE_AUTH_HEADER=Authorization
SEDERG_BALLERINE_AUTH_SCHEME=Api-Key
# Must match the Ballerine workflow service WEBHOOK_SECRET; use at least 16 random characters.
SEDERG_BALLERINE_WEBHOOK_SECRET=
SEDERG_BALLERINE_RETURN_URL=http://localhost:5173
SEDERG_BALLERINE_TIMEOUT_SECONDS=15
SEDERG_BALLERINE_WEBHOOK_TOLERANCE_SECONDS=300
SEDERG_BALLERINE_SESSION_TTL_SECONDS=3600
# Host port for the local Ballerine simulator collection UI (profile "kyc-mock").
SEDERG_BALLERINE_MOCK_PORT=5174
# Public base URL used to build the payment link inside the QR. Use the LAN IP
# of this machine (for example http://192.168.1.20:5173) so a phone can open it.
SEDERG_PUBLIC_BASE_URL=http://localhost:5173
# Lifetime of a payment link, in minutes (allowed range 5-10080).
SEDERG_PAYMENT_TTL_MINUTES=1440
# Enables the sandbox Confirm payment action outside development auth mode.
SEDERG_SANDBOX_PAYMENTS=0
VITE_AUTH_MODE=development
VITE_API_BASE_URL=
# Host port exposed for the backend API. Change it if 8080 is reserved by the OS.
SEDERG_BACKEND_PORT=8080
# Host port for Redis, bound to loopback only. 6379 is often reserved by
# Hyper-V/WinNAT on Windows, so the local default is 16379.
SEDERG_REDIS_PORT=16379
# In non-development frontend deployments, inject the access token through the OIDC host integration.
# VITE_OIDC_ACCESS_TOKEN is intentionally not supported as a build-time secret.
