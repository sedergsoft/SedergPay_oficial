SEDERG_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=sederg_pay
SEDERG_DB_USER=sederg_app
SEDERG_DB_PASSWORD=change-this-app-password
SEDERG_DB_PORT=5432
SEDERG_BACKEND_PORT=18080
SEDERG_AUTH_MODE=development
SEDERG_COOKIE_KEY=replace-with-a-random-32-byte-secret
SEDERG_PII_KEY=replace-with-a-random-encryption-secret
SEDERG_ACCOUNT_ENCRYPTION_KEY=
# Generate a local 32-byte key with scripts/Initialize-LocalAccountEncryption.ps1; never commit .env.
# --- Correo -------------------------------------------------------------------
# Transporte: smtp | api | log
#   smtp -> servidor SMTP directo (puerto 587/2525/25). Puede estar bloqueado
#           por el proveedor de nube (UpCloud en cuentas trial bloquea todo el
#           trafico SMTP saliente).
#   api  -> API HTTPS del proveedor (Brevo y compatibles). Funciona sobre 443
#           y es la opcion recomendada en la nube.
#   log  -> no envia nada: el enlace queda en el log del backend (sandbox local).
SEDERG_MAIL_TRANSPORT=smtp
SEDERG_MAIL_HOST=smtp-relay.brevo.com
SEDERG_MAIL_PORT=587
SEDERG_MAIL_ENCRYPTION=tls
# Si 587/465 están bloqueados (p. ej. en Docker/red local), Brevo también acepta 2525+tls.
# SEDERG_MAIL_PORT=2525
SEDERG_MAIL_USERNAME=your-smtp-login
SEDERG_MAIL_PASSWORD=your-smtp-password
SEDERG_MAIL_FROM=no-reply@your-domain.example
# Transporte "api" ( Brevo /v3/smtp/email ). La clave empieza por xkeysib-.
SEDERG_MAIL_API_URL=https://api.brevo.com/v3/smtp/email
SEDERG_MAIL_API_KEY=
SEDERG_MAIL_API_KEY_HEADER=api-key
SEDERG_MAIL_FROM_NAME=SEDERG_PAY
SEDERG_APP_URL=http://localhost:5173
SEDERG_OIDC_ISSUER=https://identity.example.invalid/realms/sederg
SEDERG_OIDC_AUDIENCE=sederg-pay-api
SEDERG_OIDC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----replace-with-provider-key-----END PUBLIC KEY-----"
SEDERG_CORS_ORIGINS=http://localhost:5173,https://sedergsoft.github.io
VITE_AUTH_MODE=development
VITE_API_BASE_URL=
# In non-development frontend deployments, inject the access token through the OIDC host integration.
# VITE_OIDC_ACCESS_TOKEN is intentionally not supported as a build-time secret.

# Only for the one-time legacy MySQL -> PostgreSQL import (docs/mysql-to-postgresql-data-migration.md):
# SEDERG_MYSQL_ROOT_PASSWORD=change-this-legacy-root-password
# SEDERG_MYSQL_VOLUME=sederg_pay_sederg_mysql_data

# One-time MySQL -> PostgreSQL data migration only.
# Replace with the root password from the EXISTING legacy MySQL instance.
SEDERG_MYSQL_ROOT_PASSWORD=replace-with-existing-mysql-root-password
# Existing Docker volume name from "docker volume ls".
SEDERG_MYSQL_VOLUME=sederg_pay_sederg_mysql_data
