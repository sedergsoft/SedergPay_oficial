# Variables para el stack local (deploy/local/docker-compose.local.yml)
# Copiar a .env.local y completar. NUNCA commitear el archivo rellenado.

SEDERG_DB_NAME=sederg_pay
SEDERG_DB_USER=sederg_app
SEDERG_DB_PASSWORD=change-this-app-password

SEDERG_BACKEND_PORT=18080
SEDERG_FRONTEND_PORT=5173

SEDERG_AUTH_MODE=development
SEDERG_ALLOW_DEV_HEADER_AUTH=1
SEDERG_EXPOSE_AUTH_STATE=1
SEDERG_DEBUG=0
SEDERG_KYC_REQUIRED=0

# openssl rand -hex 32
SEDERG_COOKIE_KEY=
SEDERG_PII_KEY=
# openssl rand -base64 32 (32 bytes)
SEDERG_ACCOUNT_ENCRYPTION_KEY=

SEDERG_APP_URL=http://localhost:5173
SEDERG_CORS_ORIGINS=http://localhost:5173

SEDERG_MAIL_TRANSPORT=log
SEDERG_MAIL_HOST=smtp-relay.brevo.com
SEDERG_MAIL_PORT=2525
SEDERG_MAIL_ENCRYPTION=tls
SEDERG_MAIL_USERNAME=
SEDERG_MAIL_PASSWORD=
SEDERG_MAIL_FROM=no-reply@example.invalid

VITE_AUTH_MODE=development
