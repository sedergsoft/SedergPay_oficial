# =============================================================================
# SEDERG_PAY — variables de entorno para el backend en UpCloud
# Copiar a ~/sederg-pay/.env en el servidor. NUNCA commitear este archivo.
# Permisos: chmod 600 .env
# =============================================================================

# --- Aplicación -------------------------------------------------------------
# Dominio público de la API (el que resuelve Caddy con Let's Encrypt).
# Ejemplo: sederg-pay.duckdns.org
API_DOMAIN=sederg-pay.duckdns.org
TLS_EMAIL=admin@example.com

SEDERG_APP_URL=https://5-22-219-30.sslip.io/
SEDERG_CORS_ORIGINS=https://5-22-219-30.sslip.io,https://sedergsoft.github.io

# Producción/piloto real: production + OIDC configurado. NUNCA exponer "development" en Internet.
SEDERG_AUTH_MODE=production
SEDERG_DEBUG=0
# Mantener en 0 en producción para no exponer oráculos de estado de autenticación.
SEDERG_EXPOSE_AUTH_STATE=0

# 1 exige ClamAV para adjuntos KYC (fail-closed). Recomendado en producción.
SEDERG_KYC_REQUIRED=1

# --- Base de datos ----------------------------------------------------------
# Opción A (recomendada para sandbox): TiDB Cloud Starter por pgwire.
#   SEDERG_DB_DSN=pgsql:host=GATEWAY;port=4000;dbname=sederg_pay;sslmode=require
# Opción B (recomendada para piloto): PostgreSQL 17 del stack Docker.
SEDERG_DB_DSN=pgsql:host=postgres;port=5432;dbname=sederg_pay
SEDERG_DB_USER=sederg_app
SEDERG_DB_PASSWORD=CHANGE_ME_STRONG_RANDOM

# --- Secretos de aplicación (NO reutilizar los de desarrollo) ---------------
# Generar con: openssl rand -hex 32
SEDERG_COOKIE_KEY=CHANGE_ME_64_HEX
SEDERG_PII_KEY=CHANGE_ME_64_HEX
# 32 bytes en base64 (ver scripts/Initialize-LocalAccountEncryption.ps1)
SEDERG_ACCOUNT_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# --- Almacenamiento privado -------------------------------------------------
SEDERG_PRIVATE_STORAGE_PATH=/var/lib/sederg-private

# --- Correo (Brevo u otro SMTP) ---------------------------------------------
# Transporte: smtp | api | log
#   UpCloud en cuentas trial bloquea TODO el trafico SMTP saliente (25/465/587/2525),
#   por lo que en la nube se usa "api" (Brevo /v3/smtp/email sobre HTTPS 443).
#   La clave de API de Brevo empieza por xkeysib- (no es la clave SMTP xsmtpsib-).
SEDERG_MAIL_TRANSPORT=api
SEDERG_MAIL_HOST=smtp-relay.brevo.com
SEDERG_MAIL_PORT=2525
SEDERG_MAIL_ENCRYPTION=tls
SEDERG_MAIL_USERNAME=
SEDERG_MAIL_PASSWORD=
SEDERG_MAIL_FROM=no-reply@example.com
SEDERG_MAIL_API_URL=https://api.brevo.com/v3/smtp/email
SEDERG_MAIL_API_KEY=CHANGE_ME_BREVO_API_KEY
SEDERG_MAIL_API_KEY_HEADER=api-key
SEDERG_MAIL_FROM_NAME=SEDERG_PAY

# --- Escaneo de adjuntos ----------------------------------------------------
SEDERG_CLAMD_HOST=clamav
SEDERG_CLAMD_PORT=3310

# --- OIDC (solo si SEDERG_AUTH_MODE=production) -----------------------------
SEDERG_OIDC_ISSUER=https://identity.example.invalid/realms/sederg
SEDERG_OIDC_AUDIENCE=sederg-pay-api
# Clave pública PEM en una sola línea con \n escapados.
SEDERG_OIDC_PUBLIC_KEY=

# --- Opcional: migración legacy MySQL -> PostgreSQL (una sola vez) ----------
# SEDERG_MYSQL_ROOT_PASSWORD=
# SEDERG_MYSQL_VOLUME=sederg_pay_sederg_mysql_data
