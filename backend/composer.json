{
  "name": "sederg-pay/backend",
  "description": "Backend Yii2 de SEDERG_PAY",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-bcmath": "*",
    "yiisoft/yii2": "^2.0.52",
    "yidas/yii2-composer-bower-skip": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "scripts": {
    "validate-ci": "@validate --strict"
  },
  "config": {
    "platform-check": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
